# Скопируйте этот файл в .env и заполните значения.
# Файл .env в git не попадает.

# --- Ключи сервисов ---------------------------------------------------------

# ID аккаунта Cloudflare (dash.cloudflare.com, раздел AI > Workers AI > Use REST API).
# Нужен для бесплатного режима генерации и как запасная LLM.
CF_ACCOUNT_ID=

# API-токен Cloudflare с правом Workers AI.
CF_API_TOKEN=

# API-ключ gen-api.ru (личный кабинет, раздел API-токены).
# Нужен для Seedream 4.0, автоконтроля качества и раскрытия своих тем.
GENAPI_API_KEY=

# Имя файла OAuth-клиента Google (тип Desktop app), который лежит в папке проекта.
GOOGLE_CLIENT_SECRET_FILE=client_secret.json

# --- Необязательные настройки (ниже значения по умолчанию) -------------------

# Модель генерации. Список доступных: python run_order.py --list
# Например genapi:seedream-v4 или cloudflare:flux-2-klein-4b (бесплатно).
PROVIDER=genapi:seedream-v4

# Название приложения в интерфейсе.
APP_NAME=WallGen

# Корневая папка на Google Drive, внутри неё создаётся папка на каждый заказ.
DRIVE_ROOT_FOLDER=WallGen

# 1 открывает папку заказа на Drive по ссылке, 0 оставляет её закрытой.
SHARE_ORDER_FOLDER=1

# Сколько картинок генерировать одновременно.
GEN_CONCURRENCY=24

# Когда первый раз проверять готовность картинки в gen-api и как часто дальше, в секундах.
GENAPI_FIRST_POLL=10
GENAPI_POLL_INTERVAL=3

# Автоконтроль качества vision-моделью: 1 включён, 0 выключен.
QC_ENABLED=1

# Vision-модель для автоконтроля (через gen-api).
QC_MODEL=gpt-4o-mini

# Сколько раз перегенерировать картинку, если автоконтроль нашёл брак.
QC_MAX_RETRIES=2
